+#ifdef __APPLE__
+/* Steam's folder on a Mac holds steamapps; steamclient.dylib is inside its app bundle. */
+static bool find_mac_steamclient( char *path )
+{
+    static const char *const places[] =
+    {
+        "%s/steamclient.dylib",
+        "%s/Steam.AppBundle/Steam/Contents/MacOS/steamclient.dylib",
+    };
+    const char *home = getenv( "HOME" ), *dirs[2] = {getenv( "STEAM_COMPAT_CLIENT_INSTALL_PATH" )};
+    char fallback[PATH_MAX];
+    unsigned int i, j;
+
+    if (home)
+    {
+        snprintf( fallback, sizeof(fallback), "%s/Library/Application Support/Steam", home );
+        dirs[1] = fallback;
+    }
+    for (i = 0; i < ARRAY_SIZE(dirs); i++)
+    {
+        if (!dirs[i]) continue;
+        for (j = 0; j < ARRAY_SIZE(places); j++)
+        {
+            snprintf( path, PATH_MAX, places[j], dirs[i] );
+            if (!access( path, R_OK )) return true;
+        }
+    }
+    return false;
+}
+#endif /* __APPLE__ */
