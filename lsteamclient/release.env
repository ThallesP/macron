# Valve's source the Steam bridge is built from (Proton's tag proton-11.0-2e),
# the SHA-256 of what fetch.sh takes from it, and the release asset name.
# Each digest is the SHA-256 of `shasum -a 256` over every file of that folder,
# sorted by path: GitHub does not promise that its tarballs keep the same bytes,
# the files are what is built. Bump RELEASE_TAG for every new build.
PROTON_TAG=proton-11.0-2e
PROTON_COMMIT=bc896217ffcd67f892f952b010f898fe7bd0f0a1
PROTON_URL=https://codeload.github.com/ValveSoftware/Proton/tar.gz/bc896217ffcd67f892f952b010f898fe7bd0f0a1
LSTEAMCLIENT_DIGEST=0f0974a9e4b99cc203213c3c6c7e6d0068c54b36b309b60b7efa60b80484f77a
STEAM_HELPER_DIGEST=333b6c08feafa3ad8d1bdf86feccca9d15d00c2977911eb4facb6c0bf10aed10
RELEASE_TAG=steam-bridge-proton-11.0-2e-macron.1
ASSET_NAME=macron-steam-bridge-proton-11.0-2e-macron.1-osx64.tar.xz
