+  thermal_second_ = created_;
   tolerance_ = std::chrono::microseconds(std::clamp(config.getOption<int>("dxmt.latencyTolerance", 1000), 0, 50000));
   beginFrame(1, clock::now(), {});
 }
@@ -250,6 +253,38 @@ FrameLatencyTracker::computeStart(uint64_t frame, const Estimate &est, time_poin
   return target - est.cpu - tolerance_;
 }
 
+FrameLatencyTracker::time_point
+FrameLatencyTracker::thermalStart(time_point now) {
+  if (!thermal_enabled_)
+    return {};
+  thermal_frames_++;
+  auto elapsed = now - thermal_second_;
+  if (elapsed >= std::chrono::seconds(1)) {
+    double before = thermal_.limit();
+    double limit = thermal_.update(
+        (unsigned)WMTGetThermalPressureLevel(), thermal_frames_ / std::chrono::duration<double>(elapsed).count()
+    );
+    thermal_frames_ = 0;
+    thermal_second_ = now;
+    if (limit != before) {
+      char line[160];
+      if (limit > 0)
+        snprintf(
+            line, sizeof(line), "Thermal: pressure level %u at %.1f fps, frames held to %.1f a second", thermal_.level(),
+            thermal_.rate(), limit
+        );
+      else
+        snprintf(line, sizeof(line), "Thermal: pressure level %u, frames no longer held", thermal_.level());
+      Logger::info(line);
+    }
+  }
+  if (thermal_.limit() == 0)
+    return {};
+  auto interval = std::chrono::duration_cast<duration>(std::chrono::duration<double>(1.0 / thermal_.limit()));
+  thermal_start_ = std::max(thermal_start_ + interval, now);
+  return thermal_start_;
+}
