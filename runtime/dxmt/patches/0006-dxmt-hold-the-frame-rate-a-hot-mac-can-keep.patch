diff --git a/src/dxmt/dxmt_thermal.hpp b/src/dxmt/dxmt_thermal.hpp
new file mode 100644
index 0000000..9facc5e
--- /dev/null
+++ b/src/dxmt/dxmt_thermal.hpp
@@ -0,0 +1,127 @@
+#pragma once
+
+#include <algorithm>
+
+namespace dxmt {
+
+/**
+Decides how fast a game may start frames while the Mac is hot.
+
+macOS reports how hard it is holding the machine back as a thermal pressure
+level: 0 nominal, 1 moderate, 2 heavy, 3 and 4 beyond. A Mac without a fan
+that a game keeps at full power reaches level 2 within a minute or two, and
+some tens of seconds later macOS takes the power away itself: on a MacBook
+Air M3 a game that ran at 70 frames a second fell to 14 to 30, with 70 to
+90 ms from a frame's start to the end of its GPU work and the game's sound
+mixer starved. Held to 45 frames a second the same game kept 45 for a
+minute at level 2, and held to 36 it did not reach level 2 in four minutes.
+
+So at level 2 the game is given a limit before macOS takes more. Fed once a
+second with the level and the frame rate of that second:
+- no limit until the level is 2. A Mac that never gets there is never held.
+- level 2 or more: at once a limit well below what the game was doing, and
+  a step lower for as long as the level stays, down to a floor.
+- level 1 with a limit: a step higher now and then, but for some minutes not
+  up to the rate the Mac last went to level 2 at.
+- level 0 with a limit: larger steps.
+- a limit that has come back to what the game ran at without one is removed.
+Each return to level 2 remembers a lower rate as too hot, so the limit
+settles under the highest rate the Mac holds.
+
+Nothing here knows about frames or clocks, so it runs in a test by itself.
+*/
+class ThermalPacer {
+public:
+  static constexpr unsigned kHeavy = 2;
+  static constexpr double kFloor = 24.0;
+
+  /** The limit in frames a second after this second, 0 for none. */
+  double
+  update(unsigned level, double frames_per_second) {
+    if (frames_per_second >= 1.0)
+      rate_ = rate_ > 0 ? rate_ + (frames_per_second - rate_) * kRateWeight : frames_per_second;
+    last_second_ = frames_per_second;
+    if (limit_ == 0)
+      free_rate_ = rate_;
+
+    bool rose = level > level_;
+    seconds_at_level_ = level == level_ ? seconds_at_level_ + 1 : 0;
+    level_ = level;
+    seconds_since_step_++;
+    seconds_since_heavy_++;
+
+    if (level_ >= kHeavy) {
+      seconds_since_heavy_ = 0;
+      // A game already slower than the floor (it is loading, or macOS has taken the power) is not helped by a limit
+      if (pacedRate() <= kFloor)
+        return limit_;
+      if (rose || limit_ == 0) {
+        too_hot_ = pacedRate();
+        step(pacedRate() * (limit_ > 0 ? kHeavyAgain : kHeavyFirst));
+      } else if (seconds_since_step_ >= kHeavyStepSeconds) {
+        step(pacedRate() * kHeavyStep);
+      }
+      return limit_;
+    }
+    if (limit_ == 0)
+      return 0;
+    if (level_ == 0) {
+      if (seconds_at_level_ >= kCoolSeconds && seconds_since_step_ >= kCoolStepSeconds)
+        step(limit_ * kCoolStep);
+    } else {
+      bool remembers = seconds_since_heavy_ < kTooHotSeconds;
+      double next = limit_ * kModerateStep;
+      if (seconds_since_step_ >= kModerateStepSeconds && (!remembers || next <= too_hot_ * kBelowTooHot))
+        step(next);
+    }
+    if (limit_ >= free_rate_)
+      limit_ = 0;
+    return limit_;
+  }
+
+  double limit() const { return limit_; }
+  unsigned level() const { return level_; }
+  double rate() const { return rate_; }
+
+private:
+  static constexpr double kRateWeight = 0.5;
+  static constexpr double kHeavyFirst = 0.65;
+  static constexpr double kHeavyAgain = 0.8;
+  static constexpr double kHeavyStep = 0.9;
+  static constexpr unsigned kHeavyStepSeconds = 20;
+  static constexpr double kModerateStep = 1.05;
+  static constexpr unsigned kModerateStepSeconds = 20;
+  static constexpr double kBelowTooHot = 0.9;
+  static constexpr unsigned kTooHotSeconds = 300;
+  static constexpr double kCoolStep = 1.1;
+  static constexpr unsigned kCoolSeconds = 20;
+  static constexpr unsigned kCoolStepSeconds = 10;
+
+  /**
+  What the game is doing: its rate, or the limit when that is what holds it. The rate is the higher of the
+  smoothed one and the last second's, so that a game that has just finished loading is not taken for a slow one.
+  */
+  double
+  pacedRate() const {
+    double rate = std::max(rate_, last_second_);
+    return limit_ > 0 ? std::min(limit_, rate) : rate;
+  }
+
+  void
+  step(double limit) {
+    limit_ = std::max(limit, kFloor);
+    seconds_since_step_ = 0;
+  }
+
+  unsigned level_ = 0;
+  unsigned seconds_at_level_ = 0;
+  unsigned seconds_since_step_ = 0;
+  unsigned seconds_since_heavy_ = 0;
+  double rate_ = 0;
+  double last_second_ = 0;
+  double free_rate_ = 0;
+  double too_hot_ = 0;
+  double limit_ = 0;
+};
+
+} // namespace dxmt
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
