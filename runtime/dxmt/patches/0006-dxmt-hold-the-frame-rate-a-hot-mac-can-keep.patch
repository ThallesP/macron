--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -9,6 +9,7 @@
 #include "objc/objc-runtime.h"
 #include <bootstrap.h>
 #include <mach/mach_port.h>
+#include <notify.h>
 #define WINEMETAL_API
 #include "../winemetal_thunks.h"
 #include "../airconv_thunks.h"
@@ -2531,6 +2532,24 @@ _MTLBuffer_updateContents(void *obj) {
   return STATUS_SUCCESS;
 }
 
+// What `notifyutil -g com.apple.system.thermalpressurelevel` prints: the kernel's own level, which
+// NSProcessInfo's thermalState folds into fewer.
+static NTSTATUS
+_WMTGetThermalPressureLevel(void *obj) {
+  struct unixcall_generic_obj_ret *params = obj;
+  static dispatch_once_t once;
+  static int token = NOTIFY_TOKEN_INVALID;
+  uint64_t level = 0;
+  dispatch_once(&once, ^{
+    if (notify_register_check("com.apple.system.thermalpressurelevel", &token) != NOTIFY_STATUS_OK)
+      token = NOTIFY_TOKEN_INVALID;
+  });
+  if (token == NOTIFY_TOKEN_INVALID || notify_get_state(token, &level) != NOTIFY_STATUS_OK)
+    level = 0;
+  params->ret = level;
+  return STATUS_SUCCESS;
+}
+
 static NTSTATUS
 _WMTGetOSVersion(void *obj) {
   struct unixcall_get_os_version *params = obj;
@@ -2976,6 +2995,7 @@ const void *__wine_unix_call_funcs[] = {
     &_MTLCommandBuffer_property,
     &_MTLDevice_newTileRenderPipelineState,
     &_MetalDrawable_signalEventWhenPresented,
+    &_WMTGetThermalPressureLevel,
 };
 
 #ifndef DXMT_NATIVE
@@ -3113,5 +3133,6 @@ const void *__wine_unix_call_wow64_funcs[] = {
     &_MTLCommandBuffer_property,
     &_MTLDevice_newTileRenderPipelineState,
     &_MetalDrawable_signalEventWhenPresented,
+    &_WMTGetThermalPressureLevel,
 };
 #endif
