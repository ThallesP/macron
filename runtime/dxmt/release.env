# The DXMT source the patched files are built from (the release Macron's
# runtime downloads), the compiler, and the name of the release asset. DXMT's
# own release was built with Homebrew's mingw-w64 GCC 15.2; Homebrew now has
# GCC 16, which rejects DXMT 0.80's sources, so this uses the llvm-mingw
# release DXMT's CI uses for its other jobs, pinned by checksum. Bump RELEASE_TAG for every new build: a published
# asset never changes, the runtime pins it by SHA-256.
DXMT_TAG=v0.80
DXMT_COMMIT=589adb780354b461645b29999cefaf533594ee99
DXMT_REPO=https://github.com/3Shain/dxmt.git
LLVM_MINGW_URL=https://github.com/mstorsjo/llvm-mingw/releases/download/20251216/llvm-mingw-20251216-ucrt-macos-universal.tar.xz
LLVM_MINGW_SHA256=38bb5e48ec3e0ce95fb901f4efff0bd6ffa966d1b32539a6510af816a959d160
MESON_VERSION=1.12.1
NINJA_VERSION=1.13.2
RELEASE_TAG=runtime-dxmt-0.80-macron.1
ASSET_NAME=dxmt-0.80-macron.1-overlay.tar.xz
# The Wine tree DXMT's CI builds against: its import libraries, and the
# winebuild that marks the DLLs as Wine builtins.
DXMT_WINE_URL=https://github.com/3Shain/wine/releases/download/v8.16-3shain/wine.tar.gz
DXMT_WINE_SHA256=289c7f19e270a3d3d0a6fdb07691b176c70a0795f6811e5255cba82425de4f10
