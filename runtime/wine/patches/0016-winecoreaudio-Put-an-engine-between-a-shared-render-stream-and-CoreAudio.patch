+    /* The event follows the device, playing or stopped (the unit always
+     * runs): once for every period's worth of frames it asked for. */
+    if(stream->engine){
+        stream->event_debt_frames += nframes;
+        if(stream->event_debt_frames >= stream->period_frames){
+            stream->event_debt_frames %= stream->period_frames;
+            if(!stream->pull_time) stream->pull_time = now_ns();
+            signal = TRUE;
+        }
+    }
+
     os_unfair_lock_unlock(&stream->lock);
 
+    if(signal) semaphore_signal(stream->wake);
+
     return noErr;
 }
 
