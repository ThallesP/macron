+        UINT64 signal_max, set_max, wake_max;
+    } stats;
 };
 
+/* MACRON_AUDIO=upstream leaves every stream as upstream Wine has it.
+ * MACRON_AUDIO_RESERVE=<min ms>[,<max ms>] bounds the reserve (default: one
+ * period to 100 ms; "0,0" is the engine's events without a reserve).
+ * MACRON_AUDIO_REPORT=<seconds> is how often a playing stream reports
+ * (default 60; 0 for never). */
+static BOOL engine_disabled;
+static int reserve_min_ms = -1, reserve_max_ms = 100, report_seconds = 60;
+static mach_timebase_info_data_t timebase;
+
+static void audio_report(struct coreaudio_stream *stream, BOOL last);
+
+static void engine_read_settings(void)
+{
+    const char *setting;
+
+    if(timebase.denom) return;
+    if((setting = getenv("MACRON_AUDIO")) && !strcmp(setting, "upstream")) engine_disabled = TRUE;
+    if((setting = getenv("MACRON_AUDIO_RESERVE"))){
+        char *end;
+        long ms = strtol(setting, &end, 10);
+        if(end != setting && ms >= 0 && ms <= 1000){
+            reserve_min_ms = ms;
+            if(reserve_max_ms < ms) reserve_max_ms = ms;
+            if(*end == ','){
+                setting = end + 1;
+                ms = strtol(setting, &end, 10);
+                if(end != setting && ms >= reserve_min_ms && ms <= 1000) reserve_max_ms = ms;
+            }
+        }
+    }
+    if((setting = getenv("MACRON_AUDIO_REPORT"))) report_seconds = atoi(setting);
+    mach_timebase_info(&timebase);
+}
+
+static UINT64 now_ns(void)
+{
+    return mach_absolute_time() * timebase.numer / timebase.denom;
+}
