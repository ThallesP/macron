+/* What Windows' audio engine is to a shared stream, between the client's
+ * buffer and CoreAudio.
+ *
+ * Upstream sets a stream's event from a timer of its own, once a period, and
+ * CoreAudio takes the sound straight out of the client's buffer whenever the
+ * device wants some. The two run on different clocks, and at different
+ * intervals when the stream's sample rate is not the device's, so a client
+ * that keeps only a period or two queued (SDL's WASAPI code, which most
+ * engines use) is asked for sound at moments that have nothing to do with
+ * when it is needed, and every wake-up that comes a few milliseconds late
+ * is a gap in the sound.
+ *
+ * Here the event is set when CoreAudio has asked for a period's worth of
+ * frames, as Windows sets it when its engine has taken one, so the client
+ * always has until the next pull. And the stream keeps a reserve the client is not told about:
+ * GetCurrentPadding counts only what is queued beyond it, so a client that
+ * tops its buffer up to some level tops it up to that level plus the
+ * reserve, and a wake-up that is late by less than the reserve costs
+ * nothing. The reserve is what Windows' engine has downstream of the client
+ * buffer: the stream's position counts frames as they enter it, so the
+ * position is still what was written less the padding, and the reserve a
+ * stream starts with is part of the latency GetStreamLatency reports.
+ *
+ * The reserve finds its own size. It grows by what was missing whenever
+ * CoreAudio found the buffer short while the client was feeding it, up to
+ * reserve_max_frames. After five minutes without a gap, half of what those
+ * five minutes never used is given back, down to reserve_min_frames. After
+ * Stop, what the client was not told about still
+ * plays, as what Windows' engine holds does.
+ *
+ * Called with the stream's lock held, on CoreAudio's thread, after it took
+ * `got` of the `wanted` frames of a playing stream. */
+static void engine_pulled(struct coreaudio_stream *stream, UINT32 wanted, UINT32 got)
+{
+    const UINT32 rate = stream->fmt->nSamplesPerSec;
+    BOOL fed = stream->since_write_frames < rate / 2;
+    UINT32 missing = wanted - got;
+
+    stream->stats.pulled_frames += wanted;
+    stream->since_write_frames += wanted;
+
+    if(missing && fed){
+        if(!stream->gap_frames) stream->stats.gaps++;
+        stream->gap_frames += missing;
+        stream->stats.missing_frames += missing;
+        if(stream->gap_frames > stream->stats.longest_gap_frames)
+            stream->stats.longest_gap_frames = stream->gap_frames;
+        stream->review_frames = 0;
+        stream->low_water_frames = ~0u;
+        if(stream->engine){
+            if(stream->gap_frames > stream->reserve_max_frames){
+                /* the client stopped for longer than any reserve covers (it
+                 * is loading, or paused): not what the reserve is for */
+                stream->reserve_frames -= stream->gap_grown_frames;
+                stream->gap_grown_frames = 0;
+            }else{
+                UINT32 grown = min(stream->reserve_max_frames, stream->reserve_frames + missing) - stream->reserve_frames;
+                stream->reserve_frames += grown;
+                stream->gap_grown_frames += grown;
+            }
+        }
+    }else if(!missing)
+        stream->gap_frames = stream->gap_grown_frames = 0;
+
+    if(!stream->engine) return;
+
+    if(stream->held_frames < stream->low_water_frames) stream->low_water_frames = stream->held_frames;
+    stream->review_frames += wanted;
+    if(stream->review_frames >= (UINT64)rate * 300){
+        if(stream->low_water_frames > stream->reserve_min_frames){
+            UINT32 unused = (stream->low_water_frames - stream->reserve_min_frames) / 2;
+            if(stream->reserve_frames > stream->reserve_min_frames + unused)
+                stream->reserve_frames -= unused;
+            else
+                stream->reserve_frames = stream->reserve_min_frames;
+        }
+        stream->review_frames = 0;
+        stream->low_water_frames = ~0u;
+    }
+}
