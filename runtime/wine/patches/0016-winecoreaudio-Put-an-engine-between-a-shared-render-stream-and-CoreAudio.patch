+    BOOL engine;
+    semaphore_t wake;            /* the timer thread waits here for CoreAudio to pull */
+    UINT32 ring_frames;          /* size of local_buffer; bufsize_frames is what the client sees */
+    UINT32 reserve_frames;       /* frames kept queued beyond what the client is told about */
+    UINT32 reserve_min_frames, reserve_max_frames;
+    UINT32 event_debt_frames;    /* pulled since the last event */
+    UINT32 drain_frames;         /* of the reserve, still to play after Stop */
+    UINT32 gap_frames;           /* missing so far in the gap CoreAudio is in */
+    UINT32 gap_grown_frames;     /* what that gap has added to the reserve */
+    UINT32 low_water_frames;     /* least left after a pull since the last review */
+    UINT64 review_frames;        /* pulled since the last gap or review */
+    UINT64 since_write_frames;   /* pulled since the client last wrote */
+    UINT64 position_floor;       /* the last position reported */
+    UINT64 pull_time, event_time; /* when a period was pulled, when its event was set */
