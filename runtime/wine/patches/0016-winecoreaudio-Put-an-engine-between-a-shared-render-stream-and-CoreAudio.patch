 }
 
+/* What is queued that the client is not told about: the reserve, or after
+ * Stop what is left of it to play. See engine_pulled(). */
+static UINT32 hidden_frames(const struct coreaudio_stream *stream)
+{
+    UINT32 hidden = stream->playing ? stream->reserve_frames : stream->drain_frames;
+    return min(hidden, stream->held_frames);
+}
+
+/* A client's call after its event was set: how long the wake-up took. */
+static void engine_client_woke(struct coreaudio_stream *stream)
+{
+    UINT64 took;
+
+    if(!stream->event_time) return;
+    took = now_ns() - stream->event_time;
+    stream->event_time = 0;
+    if(took > (UINT64)2000000000) return; /* it was not waiting for the event */
+    if(took > stream->stats.wake_max) stream->stats.wake_max = took;
+    if(took > (UINT64)stream->period * 100) stream->stats.slow_wakes++;
+}
+
 static UINT32 get_current_padding_nolock(struct coreaudio_stream *stream)
 {
     if(stream->flow == eCapture) capture_resample(stream);
-    return stream->held_frames;
+    engine_client_woke(stream);
+    /* what is queued beyond the reserve; see engine_pulled() */
+    return min(stream->held_frames - hidden_frames(stream), stream->bufsize_frames);
 }
 
 static NTSTATUS unix_get_current_padding(void *args)
@@ -1703,18 +1914,117 @@ static NTSTATUS unix_get_current_padding(void *args)
     return STATUS_SUCCESS;
 }
 
+/* One line a minute on stderr for each render stream that played: what
+ * CoreAudio asked for and did not get is what was heard as a gap. */
+static void audio_report(struct coreaudio_stream *stream, BOOL last)
+{
+    struct audio_stats stats;
+    UINT32 reserve, low_water;
+    UINT64 now, since;
+
+    if(stream->flow != eRender || !timebase.denom || report_seconds <= 0) return;
+    now = now_ns();
+    if(!stream->report_time) stream->report_time = now;
+    since = now - stream->report_time;
+    if(!last && since < (UINT64)report_seconds * 1000000000) return;
+
+    os_unfair_lock_lock(&stream->lock);
+    stats = stream->stats;
+    memset(&stream->stats, 0, sizeof(stream->stats));
+    reserve = stream->reserve_frames;
+    low_water = stream->low_water_frames;
+    os_unfair_lock_unlock(&stream->lock);
+    stream->report_time = now;
+    if(!stats.pulled_frames) return;
+
+    fprintf(stderr, "macron-audio: stream %u, %u Hz (period %u, buffer %u) on a %u Hz device, %s: "
+            "%.1f s, %llu frames pulled, %llu missing in %u gaps (longest %u), %u writes, "
+            "reserve %u (%u to %u), least left %d, %u events, %u more after a write, %u without a pull, "
+            "pull to event max %.2f ms (%u over 2 ms), event set max %.2f ms, "
+            "event to client max %.2f ms (%u over a period)\n",
+            stream->id, (unsigned int)stream->fmt->nSamplesPerSec, stream->period_frames, stream->bufsize_frames,
+            stream->dev_rate, stream->engine ? "engine" : "upstream",
+            since / 1e9, (unsigned long long)stats.pulled_frames, (unsigned long long)stats.missing_frames,
+            stats.gaps, stats.longest_gap_frames,
+            stats.writes, reserve, stream->reserve_min_frames, stream->reserve_max_frames,
+            low_water == ~0u ? -1 : (int)low_water, stats.events, stats.kicks, stats.timeouts,
+            stats.signal_max / 1e6, stats.slow_signals, stats.set_max / 1e6,
+            stats.wake_max / 1e6, stats.slow_wakes);
+}
+
+/* The engine's side of the timer thread: set the event when CoreAudio has
+ * asked for a period, playing or stopped (upstream sets it in both too), and
+ * every two periods if the device stops asking. */
+static void engine_timer_loop(struct coreaudio_stream *stream)
+{
+    const UINT64 period_ns = (UINT64)stream->period * 100;
+    mach_timespec_t wait, none = {0, 0};
+    UINT64 pulled, before, after;
+    kern_return_t ret;
+
+    while(!stream->please_quit){
+        UINT64 timeout = period_ns * 2;
+
+        wait.tv_sec = timeout / 1000000000;
+        wait.tv_nsec = timeout % 1000000000;
+        ret = semaphore_timedwait(stream->wake, wait);
+        if(stream->please_quit) break;
+        /* several pulls the thread slept through are one event */
+        while(semaphore_timedwait(stream->wake, none) == KERN_SUCCESS) ;
+
+        before = now_ns();
+        os_unfair_lock_lock(&stream->lock);
+        pulled = stream->pull_time;
+        stream->pull_time = 0;
+        if(!stream->event_time) stream->event_time = before;
+        os_unfair_lock_unlock(&stream->lock);
+
+        if(stream->event) NtSetEvent(stream->event, NULL);
+        after = now_ns();
+
+        os_unfair_lock_lock(&stream->lock);
+        stream->stats.events++;
+        if(ret != KERN_SUCCESS) stream->stats.timeouts++;
+        else if(pulled){
+            if(before - pulled > stream->stats.signal_max) stream->stats.signal_max = before - pulled;
+            if(before - pulled > 2000000) stream->stats.slow_signals++;
+        }
+        if(after - before > stream->stats.set_max) stream->stats.set_max = after - before;
+        os_unfair_lock_unlock(&stream->lock);
+
+        audio_report(stream, FALSE);
+    }
+}
+
 static void unix_timer_loop(void *args)
 {
     struct coreaudio_stream *stream = args;
     LARGE_INTEGER delay, next, last;
     int adjust;
 
+    if(stream->engine){
+        engine_timer_loop(stream);
+        return;
+    }
+
     delay.QuadPart = -stream->period;
     NtQueryPerformanceCounter(&last, NULL);
     next.QuadPart = last.QuadPart + stream->period;
 
     while(!stream->please_quit){
+        UINT64 before = now_ns(), after;
+
+        os_unfair_lock_lock(&stream->lock);
+        if(!stream->event_time) stream->event_time = before;
+        os_unfair_lock_unlock(&stream->lock);
         NtSetEvent(stream->event, NULL);
+        after = now_ns();
+        os_unfair_lock_lock(&stream->lock);
+        stream->stats.events++;
+        if(after - before > stream->stats.set_max) stream->stats.set_max = after - before;
+        os_unfair_lock_unlock(&stream->lock);
+        audio_report(stream, FALSE);
+
         NtDelayExecution(FALSE, &delay);
         NtQueryPerformanceCounter(&last, NULL);
 
