+ */
+
+/* Every OpenGL call goes from opengl32's Windows side to its Unix side, and
+ * on some hosts that transition costs far more than the call: on macOS under
+ * Rosetta about 14 µs, because Wine's dispatcher switches %gs between the TEB
+ * and the host's thread data with two Mach traps.
+ *
+ * So calls that return nothing and whose arguments are values, or point to
+ * data whose size is known when they are made (glBufferSubData, glUniform*v,
+ * ...), are queued per thread, the data copied, and the queue is replayed by
+ * a single Unix call (flush_batch) before any other call reaches the Unix
+ * side: one that returns something or reads or writes memory later, a context
+ * change, a swap, glFlush, glFinish, thread exit. The Unix side replays each
+ * queued call through the same entry point it would have reached directly, so
+ * the order of calls and what they do are unchanged, glGetError included.
+ *
+ * Draws read vertex arrays, which may live in client memory that the caller
+ * may change after the draw returns: they are queued only while no vertex
+ * array of the process was ever given a client pointer (a pointer set while
+ * no GL_ARRAY_BUFFER was bound), and elements draws only while an element
+ * array buffer is known to be bound, so their indices are an offset.
+ *
+ * WINE_OPENGL_BATCH=0 in the environment turns batching off.
+ */
+
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+
+#include "unixlib.h"
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(opengl);
+
+enum batch_flags
+{
+    BATCH_QUEUE           = 0x01, /* may be queued */
+    BATCH_DRAW            = 0x02, /* reads vertex arrays: queued only without client arrays */
+    BATCH_ELEMENTS        = 0x04, /* reads indices: queued only with an element array buffer bound */
+    BATCH_POINTER         = 0x08, /* sets a vertex array pointer: queued only with an array buffer bound */
+    BATCH_CLIENT_ARRAYS   = 0x10, /* sets a vertex array in client memory */
+    BATCH_BIND_BUFFER     = 0x20, /* glBindBuffer */
+    BATCH_FORGET_ELEMENTS = 0x40, /* may change the element array buffer binding */
+    BATCH_FORGET_BINDINGS = 0x80, /* may change the array and element array buffer bindings */
+};
+
+struct batch_desc
+{
+    UINT16 flags;
+    UINT16 size;       /* size of the call's params */
+    UINT16 data;       /* offset of the pointer to the data to copy, 0 if none */
+    UINT16 count;      /* offset of the number of elements of the data */
+    UINT8  count_size; /* size of that number, 0 if the data has a fixed size */
+    UINT8  unit;       /* size of an element of the data, or of all of it */
+};
+
+#define PARAMS_SIZE( f ) sizeof(struct f##_params)
+#define BATCH_FLAGS( f, flags ) [unix_##f] = { (flags) }
+#define BATCH_VALUE( f ) [unix_##f] = { BATCH_QUEUE, PARAMS_SIZE( f ) }
+#define BATCH_VALUE_FLAGS( f, flags ) [unix_##f] = { BATCH_QUEUE | (flags), PARAMS_SIZE( f ) }
+#define BATCH_DRAW( f ) [unix_##f] = { BATCH_QUEUE | BATCH_DRAW, PARAMS_SIZE( f ) }
+#define BATCH_DRAW_ELEMENTS( f ) [unix_##f] = { BATCH_QUEUE | BATCH_DRAW | BATCH_ELEMENTS, PARAMS_SIZE( f ) }
+#define BATCH_POINTER( f ) [unix_##f] = { BATCH_QUEUE | BATCH_POINTER, PARAMS_SIZE( f ) }
+#define BATCH_COPY( f, ptr, bytes ) \
+    [unix_##f] = { BATCH_QUEUE, PARAMS_SIZE( f ), offsetof(struct f##_params, ptr), 0, 0, (bytes) }
+#define BATCH_COPY_N( f, ptr, n, bytes ) \
+    [unix_##f] = { BATCH_QUEUE, PARAMS_SIZE( f ), offsetof(struct f##_params, ptr), \
+                   offsetof(struct f##_params, n), sizeof(((struct f##_params *)0)->n), (bytes) }
+
+#include "batch_table.h"
+
+#define WINE_GL_RESERVED_BATCH 6 /* TEB glReserved1 slot, after wgl.c's */
+#define BATCH_SIZE (128 * 1024)
+#define BATCH_MAX_DATA (BATCH_SIZE / 4)
+
+struct batch
+{
+    BOOL busy;           /* replaying: calls go straight to the Unix side */
+    BOOL array_buffer;   /* GL_ARRAY_BUFFER is known to be bound */
+    BOOL element_buffer; /* GL_ELEMENT_ARRAY_BUFFER is known to be bound */
+    UINT used;
+    UINT64 data[BATCH_SIZE / sizeof(UINT64)];
+};
+
+static BOOL batch_disabled;
+static LONG client_arrays; /* a vertex array was set in client memory */
+
+static inline UINT batch_align( SIZE_T size )
+{
+    return (size + 7) & ~7;
+}
+
+static struct batch *get_batch(void)
+{
+    struct batch *batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH];
+
+    if (batch || batch_disabled) return batch;
+    if (!(batch = calloc( 1, sizeof(*batch) ))) return NULL;
+    NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH] = batch;
+    return batch;
+}
+
+static void flush_batch( struct batch *batch )
+{
+    struct flush_batch_params args = { .data = batch->data, .size = batch->used };
+    NTSTATUS status;
+
+    if (!batch->used) return;
+    batch->busy = TRUE;
+    if ((status = WINE_UNIX_CALL( unix_flush_batch, &args ))) WARN( "flush_batch returned %#lx\n", status );
+    batch->busy = FALSE;
+    batch->used = 0;
+}
+
+static BOOL can_queue( const struct batch *batch, const struct batch_desc *desc )
+{
+    if (!(desc->flags & BATCH_QUEUE)) return FALSE;
+    if ((desc->flags & BATCH_DRAW) && client_arrays) return FALSE;
+    if ((desc->flags & BATCH_ELEMENTS) && !batch->element_buffer) return FALSE;
+    if ((desc->flags & BATCH_POINTER) && !batch->array_buffer) return FALSE;
+    return TRUE;
+}
+
+/* the size of the data a call points to, 0 if it cannot be queued */
+static SIZE_T data_size( const struct batch_desc *desc, const void *args )
+{
+    const char *params = args;
+    INT64 count;
+
+    if (!*(const void *const *)(params + desc->data)) return 0;
+    if (!desc->count_size) return desc->unit;
+    if (desc->count_size == sizeof(INT64)) count = *(const INT64 *)(params + desc->count);
+    else count = *(const INT32 *)(params + desc->count);
+    if (count <= 0 || count > BATCH_MAX_DATA / desc->unit) return 0;
+    return count * desc->unit;
+}
+
+static void track_state( struct batch *batch, const struct batch_desc *desc, const void *args )
+{
+    if (desc->flags & BATCH_BIND_BUFFER)
+    {
+        const struct glBindBuffer_params *params = args;
+        if (params->target == GL_ARRAY_BUFFER) batch->array_buffer = !!params->buffer;
+        if (params->target == GL_ELEMENT_ARRAY_BUFFER) batch->element_buffer = !!params->buffer;
+    }
+    if (desc->flags & BATCH_FORGET_BINDINGS) batch->array_buffer = FALSE;
+    if (desc->flags & (BATCH_FORGET_BINDINGS | BATCH_FORGET_ELEMENTS)) batch->element_buffer = FALSE;
+    if ((desc->flags & BATCH_CLIENT_ARRAYS) || ((desc->flags & BATCH_POINTER) && !batch->array_buffer))
+    {
+        if (!InterlockedExchange( &client_arrays, 1 ))
+            WARN( "A vertex array is in client memory, draws will not be batched\n" );
+    }
+}
+
+NTSTATUS opengl_unix_call( UINT code, void *args )
+{
+    const struct batch_desc *desc = batch_descs + code;
+    struct batch *batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH];
+    struct batch_entry *entry;
+    SIZE_T copy = 0, size;
+    BOOL queue;
+    char *params;
+
+    if (!batch && (!desc->flags || !(batch = get_batch()))) return WINE_UNIX_CALL( code, args );
+    if (batch->busy) return WINE_UNIX_CALL( code, args );
+
+    if ((queue = can_queue( batch, desc )) && desc->data && !(copy = data_size( desc, args ))) queue = FALSE;
+    track_state( batch, desc, args );
+    if (!queue)
+    {
+        flush_batch( batch );
+        return WINE_UNIX_CALL( code, args );
+    }
+
+    size = sizeof(*entry) + batch_align( desc->size ) + batch_align( copy );
+    if (batch->used + size > sizeof(batch->data)) flush_batch( batch );
+
+    entry = (struct batch_entry *)((char *)batch->data + batch->used);
+    entry->code = code;
+    entry->size = size;
+    params = memcpy( entry + 1, args, desc->size );
+    if (desc->data)
+    {
+        char *data = params + batch_align( desc->size );
+        memcpy( data, *(void **)((char *)args + desc->data), copy );
+        *(void **)(params + desc->data) = data;
+    }
+    batch->used += size;
+    return STATUS_SUCCESS;
+}
+
+void batch_process_attach(void)
+{
+    char value[8];
+
+    if (GetEnvironmentVariableA( "WINE_OPENGL_BATCH", value, sizeof(value) ) && value[0] == '0') batch_disabled = TRUE;
+    TRACE( "OpenGL call batching %s\n", batch_disabled ? "disabled" : "enabled" );
+}
+
+void batch_thread_detach(void)
+{
+    struct batch *batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH];
+
+    /* the queue was replayed before thread_detach reached the Unix side */
+    NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH] = NULL;
+    free( batch );
+}
