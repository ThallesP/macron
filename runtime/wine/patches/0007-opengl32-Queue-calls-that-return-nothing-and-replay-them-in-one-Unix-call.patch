+/* replays the calls opengl32's Windows side queued (batch.c), in order */
+NTSTATUS flush_batch( void *args )
+{
+    struct flush_batch_params *params = args;
+    char *ptr = (char *)params->data, *end = ptr + params->size;
+    struct batch_entry *entry;
+
+    for (; ptr < end; ptr += entry->size)
+    {
+        entry = (struct batch_entry *)ptr;
+        if (entry->code <= unix_flush_batch || entry->code >= funcs_count || entry->size < sizeof(*entry))
+            return STATUS_INVALID_PARAMETER;
+        __wine_unix_call_funcs[entry->code]( entry + 1 );
+    }
+    return STATUS_SUCCESS;
+}
