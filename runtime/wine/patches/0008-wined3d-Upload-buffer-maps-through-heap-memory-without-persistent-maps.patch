From: Macron <macron@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:00:00 +0000
Subject: [PATCH] wined3d: Upload buffer maps through heap memory whenever
 buffers cannot be mapped persistently.

Without ARB_buffer_storage, wined3d cannot allocate and map a buffer
object from the application's thread, so a 64-bit process serves every
DISCARD or NOOVERWRITE buffer map (each DrawPrimitiveUP, each dynamic
vertex buffer lock) through the command stream: the application's
thread waits for the command stream to map the whole buffer object, and
again to flush and unmap it. Each of those is a call into the host
OpenGL that returns a value, so none of them can be queued.

Patch 0003 already sends such maps through heap memory in a WoW64
process, where opengl32 copies buffer maps. Do the same in any process
whose buffers cannot be mapped persistently: the map returns heap memory
the size of the mapped range at once, and the command stream uploads it
with glBufferSubData on unmap. A WoW64 process takes exactly the path it
took with 0003; a host with persistent maps the same path as before.
---
--- a/dlls/wined3d/adapter_gl.c
+++ b/dlls/wined3d/adapter_gl.c
@@ -4903,13 +4903,6 @@
     .adapter_generate_mipmap = adapter_gl_generate_mipmap,
 };
 
-static BOOL wined3d_is_wow64(void)
-{
-    BOOL is_wow64;
-
-    return sizeof(void *) == sizeof(int) && IsWow64Process(GetCurrentProcess(), &is_wow64) && is_wow64;
-}
-
 static void wined3d_adapter_gl_init_d3d_info(struct wined3d_adapter_gl *adapter_gl, uint32_t wined3d_creation_flags)
 {
     const struct wined3d_gl_info *gl_info = &adapter_gl->gl_info;
@@ -4970,10 +4963,12 @@
     d3d_info->feature_level = feature_level_from_caps(gl_info, &shader_caps, &d3d_info->ffp_fragment_caps);
     d3d_info->filling_convention_offset = gl_info->filling_convention_offset;
     d3d_info->persistent_map = !!gl_info->supported[ARB_BUFFER_STORAGE];
-    /* A 32-bit process on 64-bit Wine gets buffer maps that opengl32 emulates
-     * by copying the whole mapped range into and out of low memory, unless the
-     * host can map buffers persistently. */
-    d3d_info->copied_maps = !d3d_info->persistent_map && wined3d_is_wow64();
+    /* Without persistent maps a buffer object cannot be allocated and mapped
+     * from the application's thread, so every DISCARD or NOOVERWRITE map of a
+     * buffer would wait for the command stream to map the whole buffer object
+     * (and, in a 32-bit process on 64-bit Wine, for opengl32 to copy all of it
+     * into and out of low memory). Such maps go through heap memory instead. */
+    d3d_info->heap_buffer_maps = !d3d_info->persistent_map;
     d3d_info->ffp_hlsl = wined3d_settings.ffp_hlsl;
 
     if (gl_info->supported[ARB_TEXTURE_MULTISAMPLE])
--- a/dlls/wined3d/context_gl.c
+++ b/dlls/wined3d/context_gl.c
@@ -3030,7 +3030,7 @@
     else if (dst_bo && !src_bo)
     {
         if ((map_flags & WINED3D_MAP_DISCARD) && (dst_bo->flags & GL_MAP_WRITE_BIT)
-                && !context_gl->c.d3d_info->copied_maps)
+                && !context_gl->c.d3d_info->heap_buffer_maps)
         {
             dst_ptr = wined3d_context_gl_map_bo_address(context_gl, dst, dst_bo->size, map_flags);
             memcpy(dst_ptr, src->addr, dst_bo->size);
--- a/dlls/wined3d/cs.c
+++ b/dlls/wined3d/cs.c
@@ -3222,14 +3222,15 @@
     }
 }
 
-/* Mapping a buffer object would copy all of it into and out of low memory; a
- * heap copy of the mapped range is uploaded with glBufferSubData instead.
- * Buffers the application can read, or whose system memory is pinned, keep
- * the usual path. */
+/* Without persistent maps, mapping a buffer object means waiting for the
+ * command stream to map it (and, in WoW64, copying all of it into and out of
+ * low memory); a heap copy of the mapped range is uploaded with
+ * glBufferSubData instead, without waiting. Buffers the application can read,
+ * or whose system memory is pinned, keep the usual path. */
 static bool wined3d_cs_upload_buffer_through_heap(const struct wined3d_device_context *context,
         const struct wined3d_resource *resource)
 {
-    return resource->type == WINED3D_RTYPE_BUFFER && context->device->adapter->d3d_info.copied_maps
+    return resource->type == WINED3D_RTYPE_BUFFER && context->device->adapter->d3d_info.heap_buffer_maps
             && !(resource->access & WINED3D_RESOURCE_ACCESS_MAP_R) && !resource->pin_sysmem;
 }
 
@@ -3242,7 +3243,7 @@
 
     if (wined3d_cs_upload_buffer_through_heap(context, resource))
     {
-        TRACE_(d3d_perf)("Mapping buffer %p through heap memory, buffer maps are copied.\n", resource);
+        TRACE_(d3d_perf)("Mapping buffer %p through heap memory, buffers are not mapped persistently.\n", resource);
     }
     else if (flags & (WINED3D_MAP_DISCARD | WINED3D_MAP_NOOVERWRITE))
     {
--- a/dlls/wined3d/wined3d_private.h
+++ b/dlls/wined3d/wined3d_private.h
@@ -244,7 +244,7 @@
     uint32_t subpixel_viewport : 1;
     uint32_t fences : 1;
     uint32_t persistent_map : 1;
-    uint32_t copied_maps : 1;
+    uint32_t heap_buffer_maps : 1;
     uint32_t gpu_push_constants : 1;
     uint32_t ffp_hlsl : 1;
     enum wined3d_feature_level feature_level;
