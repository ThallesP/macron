From: Macron <macron@users.noreply.github.com>
Date: Sun, 15 Nov 2026 06:00:00 +0000
Subject: [PATCH] wow64cpu: Switch between 32-bit and 64-bit code with iret
 instead of far jumps.

Under Rosetta, on Apple silicon, a far jump between the 32-bit and the
64-bit code segment sometimes runs its target in the old mode. A 32-bit
Direct3D 9 program on Apple's software OpenGL renderer hits it in both
directions while it creates its device: the Unix call thunk's ljmp
lands in unix_call_32to64 still in 32-bit mode (a page fault at its
first RIP-relative load, cs32_sel(%rip), read as an absolute address),
and the ljmp back lands in the 32-bit caller still in 64-bit mode.

Enter 64-bit code from the thunks with iretl (pushfl; pushl cs; pushl
target; iretl, the same 12 bytes as the far jump), and return to 32-bit
code with iretq on the fast path too, as the reset-state path already
does. Measured on a GitHub macos-26 runner, 40 starts each, alternating:
the program failed 25 times with far jumps both ways, 14 times with
iretq only on the way back, and 0 times with iret both ways.
---
--- a/dlls/wow64cpu/cpu.c
+++ b/dlls/wow64cpu/cpu.c
@@ -33,11 +33,12 @@
 #pragma pack(push,1)
 struct thunk_32to64
 {
-    BYTE  ljmp;   /* jump far, absolute indirect */
-    BYTE  modrm;  /* address=disp32, opcode=5 */
-    DWORD op;
+    BYTE  pushfl;    /* pushl the flags, for iretl */
+    BYTE  push_cs;   /* pushl imm32 */
+    DWORD cs;
+    BYTE  push_addr; /* pushl imm32 */
     DWORD addr;
-    WORD  cs;
+    BYTE  iretl;     /* iretl in 32-bit mode pops eip, cs and the flags */
 };
 struct thunk_opcodes
 {
@@ -203,14 +204,22 @@
                    "movl 0xa4(%r13),%ebx\n\t"   /* context->Ebx */
                    "movl 0xb4(%r13),%ebp\n\t"   /* context->Ebp */
                    "btrl $0,-4(%r13)\n\t"       /* cpu->Flags & WOW64_CPURESERVED_FLAG_RESET_STATE */
-                   "jc .Lsyscall_32to64_return\n\t"
-                   "movl 0xb8(%r13),%edx\n\t"   /* context->Eip */
-                   "movl %edx,(%rsp)\n\t"
+                   "jc .Lsyscall_32to64_return\n"
+                   /* back to 32-bit code with iretq, not a far jump (see BTCpuProcessInit) */
+                   ".Lsyscall_32to64_iret:\n\t"
+                   "movq %rsp,%r14\n\t"
+                   "movl 0xc8(%r13),%edx\n\t"   /* context->SegSs */
+                   "movq %rdx,0x20(%rsp)\n\t"
+                   "movl 0xc4(%r13),%edx\n\t"   /* context->Esp */
+                   "movq %rdx,0x18(%rsp)\n\t"
+                   "pushfq\n\t"
+                   "popq %rdx\n\t"
+                   "movq %rdx,0x10(%rsp)\n\t"
                    "movl 0xbc(%r13),%edx\n\t"   /* context->SegCs */
-                   "movl %edx,4(%rsp)\n\t"
-                   "movl 0xc4(%r13),%r14d\n\t"  /* context->Esp */
-                   "xchgq %r14,%rsp\n\t"
-                   "ljmp *(%r14)\n"
+                   "movq %rdx,0x8(%rsp)\n\t"
+                   "movl 0xb8(%r13),%edx\n\t"   /* context->Eip */
+                   "movq %rdx,(%rsp)\n\t"
+                   "iretq\n"
                    ".Lsyscall_32to64_return:\n\t"
                    "movq %rsp,%r14\n\t"
                    "movl 0xa8(%r13),%edx\n\t"   /* context->Edx */
@@ -264,13 +273,7 @@
                    "movl %eax,0xb0(%r13)\n\t"   /* context->Eax */
                    "btrl $0,-4(%r13)\n\t"       /* cpu->Flags & WOW64_CPURESERVED_FLAG_RESET_STATE */
                    "jc .Lsyscall_32to64_return\n\t"
-                   "movl 0xb8(%r13),%edx\n\t"   /* context->Eip */
-                   "movl %edx,(%rsp)\n\t"
-                   "movl 0xbc(%r13),%edx\n\t"   /* context->SegCs */
-                   "movl %edx,4(%rsp)\n\t"
-                   "movl 0xc4(%r13),%r14d\n\t"  /* context->Esp */
-                   "xchgq %r14,%rsp\n\t"
-                   "ljmp *(%r14)" )
+                   "jmp .Lsyscall_32to64_iret" )
 
 
 /**********************************************************************
@@ -335,17 +338,22 @@
     cs32_sel = context_i386.SegCs;
     ss32_sel = context_i386.SegSs;
 
-    thunk->syscall_thunk.ljmp  = 0xff;
-    thunk->syscall_thunk.modrm = 0x2d;
-    thunk->syscall_thunk.op    = PtrToUlong( &thunk->syscall_thunk.addr );
-    thunk->syscall_thunk.addr  = PtrToUlong( syscall_32to64 );
-    thunk->syscall_thunk.cs    = cs64_sel;
-
-    thunk->unix_thunk.ljmp  = 0xff;
-    thunk->unix_thunk.modrm = 0x2d;
-    thunk->unix_thunk.op    = PtrToUlong( &thunk->unix_thunk.addr );
-    thunk->unix_thunk.addr  = PtrToUlong( unix_call_32to64 );
-    thunk->unix_thunk.cs    = cs64_sel;
+    /* Enter 64-bit code with iretl, and return to 32-bit code with iretq,
+     * instead of far jumps: under Rosetta a far jump between the 32-bit and
+     * the 64-bit code segment sometimes runs its target in the old mode. */
+    thunk->syscall_thunk.pushfl    = 0x9c;
+    thunk->syscall_thunk.push_cs   = 0x68;
+    thunk->syscall_thunk.cs        = cs64_sel;
+    thunk->syscall_thunk.push_addr = 0x68;
+    thunk->syscall_thunk.addr      = PtrToUlong( syscall_32to64 );
+    thunk->syscall_thunk.iretl     = 0xcf;
+
+    thunk->unix_thunk.pushfl    = 0x9c;
+    thunk->unix_thunk.push_cs   = 0x68;
+    thunk->unix_thunk.cs        = cs64_sel;
+    thunk->unix_thunk.push_addr = 0x68;
+    thunk->unix_thunk.addr      = PtrToUlong( unix_call_32to64 );
+    thunk->unix_thunk.iretl     = 0xcf;
 
     NtProtectVirtualMemory( GetCurrentProcess(), (void **)&thunk, &size, PAGE_EXECUTE_READ, &old_prot );
     return STATUS_SUCCESS;
