diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index 5892a75..ed279e1 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -1256,6 +1256,40 @@ NTSTATUS flush_batch( void *args )
     return STATUS_SUCCESS;
 }
 
+/* Writes data into a buffer object without waiting for the GPU, for writes
+ * that Direct3D guarantees do not touch anything a draw already issued still
+ * reads (NOOVERWRITE locks, and DISCARD locks after the buffer was orphaned).
+ * Apple's OpenGL on Apple silicon is a layer over Metal: there glBufferSubData
+ * into a buffer that issued draws still use submits the command buffer and
+ * waits for the GPU every time, an unsynchronized map does not. The map and
+ * the copy happen here, so a 32-bit program never sees a 64-bit pointer. */
+static void write_buffer_unsynchronized( const struct opengl_funcs *funcs, GLenum target, GLintptr offset,
+                                         GLsizeiptr size, const void *data )
+{
+    void *ptr = NULL;
+
+    if (funcs->p_glMapBufferRange && funcs->p_glUnmapBuffer)
+        ptr = funcs->p_glMapBufferRange( target, offset, size, GL_MAP_WRITE_BIT | GL_MAP_UNSYNCHRONIZED_BIT |
+                                         GL_MAP_INVALIDATE_RANGE_BIT );
+    if (!ptr)
+    {
+        funcs->p_glBufferSubData( target, offset, size, data );
+        return;
+    }
+    memcpy( ptr, data, size );
+    funcs->p_glUnmapBuffer( target );
+}
+
+NTSTATUS buffer_write_unsynchronized( void *args )
+{
+    struct buffer_write_unsynchronized_params *params = args;
+    const struct opengl_funcs *funcs = params->teb->glTable;
+
+    if (!funcs->p_glBufferSubData) return STATUS_NOT_IMPLEMENTED;
+    write_buffer_unsynchronized( funcs, params->target, params->offset, params->size, params->data );
+    return STATUS_SUCCESS;
+}
+
 NTSTATUS get_pixel_formats( void *args )
 {
     struct get_pixel_formats_params *params = args;
@@ -2059,6 +2093,25 @@ NTSTATUS wow64_get_pixel_formats( void *args )
     return status;
 }
 
+NTSTATUS wow64_buffer_write_unsynchronized( void *args )
+{
+    struct
+    {
+        PTR32 teb;
+        GLenum target;
+        PTR32 offset;
+        PTR32 size;
+        PTR32 data;
+    } *params32 = args;
+    TEB *teb = get_teb64( params32->teb );
+    const struct opengl_funcs *funcs = teb->glTable;
+
+    if (!funcs->p_glBufferSubData) return STATUS_NOT_IMPLEMENTED;
+    write_buffer_unsynchronized( funcs, params32->target, (GLintptr)ULongToPtr( params32->offset ),
+                                 (GLsizeiptr)ULongToPtr( params32->size ), ULongToPtr( params32->data ) );
+    return STATUS_SUCCESS;
+}
+
 NTSTATUS wow64_flush_batch( void *args )
 {
     struct
