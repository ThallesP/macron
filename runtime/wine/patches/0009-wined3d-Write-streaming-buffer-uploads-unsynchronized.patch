diff --git a/dlls/wined3d/buffer.c b/dlls/wined3d/buffer.c
index 5e1f0de..e067778 100644
--- a/dlls/wined3d/buffer.c
+++ b/dlls/wined3d/buffer.c
@@ -787,10 +787,21 @@ void wined3d_buffer_acquire_bo_for_write(struct wined3d_buffer *buffer, struct w
     wined3d_context_copy_bo_address(context, &dst, &src, 1, &range, WINED3D_MAP_WRITE | WINED3D_MAP_DISCARD);
 }
 
+static void wined3d_buffer_copy_bo_address_flags(struct wined3d_buffer *dst_buffer, struct wined3d_context *context,
+        unsigned int dst_offset, const struct wined3d_const_bo_address *src_addr, unsigned int size, uint32_t map_flags);
+
 void wined3d_buffer_copy_bo_address(struct wined3d_buffer *dst_buffer, struct wined3d_context *context,
         unsigned int dst_offset, const struct wined3d_const_bo_address *src_addr, unsigned int size)
 {
-    uint32_t map_flags = WINED3D_MAP_WRITE;
+    wined3d_buffer_copy_bo_address_flags(dst_buffer, context, dst_offset, src_addr, size, WINED3D_MAP_WRITE);
+}
+
+/* map_flags may carry WINED3D_MAP_NOOVERWRITE or WINED3D_MAP_DISCARD from the
+ * application's map; DISCARD then discards the whole buffer even though only
+ * [dst_offset, dst_offset + size) is written. */
+static void wined3d_buffer_copy_bo_address_flags(struct wined3d_buffer *dst_buffer, struct wined3d_context *context,
+        unsigned int dst_offset, const struct wined3d_const_bo_address *src_addr, unsigned int size, uint32_t map_flags)
+{
     struct wined3d_bo_address dst_addr;
     struct wined3d_range range;
     DWORD dst_location;
@@ -807,7 +818,10 @@ void wined3d_buffer_copy_bo_address(struct wined3d_buffer *dst_buffer, struct wi
     range.offset = 0;
     range.size = size;
     wined3d_context_copy_bo_address(context, &dst_addr, (const struct wined3d_bo_address *)src_addr, 1, &range, map_flags);
-    wined3d_buffer_invalidate_range(dst_buffer, ~dst_location, dst_offset, size);
+    if (map_flags & WINED3D_MAP_DISCARD)
+        wined3d_buffer_invalidate_location(dst_buffer, ~dst_location);
+    else
+        wined3d_buffer_invalidate_range(dst_buffer, ~dst_location, dst_offset, size);
 }
 
 void wined3d_buffer_copy(struct wined3d_buffer *dst_buffer, unsigned int dst_offset,
@@ -878,7 +892,13 @@ void wined3d_buffer_update_sub_resource(struct wined3d_buffer *buffer, struct wi
     }
     else
     {
-        wined3d_buffer_copy_bo_address(buffer, context, offset, &upload_bo->addr, size);
+        uint32_t map_flags = WINED3D_MAP_WRITE;
+
+        if (upload_bo->flags & UPLOAD_BO_DISCARD)
+            map_flags |= WINED3D_MAP_DISCARD;
+        else if (upload_bo->flags & UPLOAD_BO_NOOVERWRITE)
+            map_flags |= WINED3D_MAP_NOOVERWRITE;
+        wined3d_buffer_copy_bo_address_flags(buffer, context, offset, &upload_bo->addr, size, map_flags);
     }
 }
 
diff --git a/dlls/wined3d/context_gl.c b/dlls/wined3d/context_gl.c
index 229153b..0151c6e 100644
--- a/dlls/wined3d/context_gl.c
+++ b/dlls/wined3d/context_gl.c
@@ -3036,6 +3036,39 @@ void wined3d_context_gl_copy_bo_address(struct wined3d_context_gl *context_gl,
             memcpy(dst_ptr, src->addr, dst_bo->size);
             wined3d_context_gl_unmap_bo_address(context_gl, dst, range_count, ranges);
         }
+        else if ((map_flags & (WINED3D_MAP_DISCARD | WINED3D_MAP_NOOVERWRITE))
+                && context_gl->c.d3d_info->heap_buffer_maps && gl_info->p_glBufferWriteUnsynchronizedWINE)
+        {
+            /* A NOOVERWRITE or DISCARD map through heap memory: nothing an
+             * issued draw reads is overwritten, once a DISCARD has given the
+             * buffer object new storage. glBufferSubData would wait for the
+             * GPU on Apple's OpenGL over Metal whenever earlier draws use the
+             * buffer, which for a streaming buffer is every upload. */
+            wined3d_context_gl_bind_bo(context_gl, dst_bo->binding, dst_bo->id);
+            if ((map_flags & WINED3D_MAP_DISCARD) && !dst_bo->memory && !dst_bo->b.buffer_offset)
+            {
+                TRACE_(d3d_perf)("Orphaning BO %u for a DISCARD upload.\n", dst_bo->id);
+                GL_EXTCALL(glBufferData(dst_bo->binding, dst_bo->size, NULL, dst_bo->usage));
+            }
+            else if (map_flags & WINED3D_MAP_DISCARD)
+            {
+                /* Not a buffer object of its own: keep the waiting upload. */
+                map_flags &= ~WINED3D_MAP_DISCARD;
+            }
+            for (i = 0; i < range_count; ++i)
+            {
+                GLintptr offset = dst_bo->b.buffer_offset + (GLintptr)dst->addr + ranges[i].offset;
+
+                if (map_flags & (WINED3D_MAP_DISCARD | WINED3D_MAP_NOOVERWRITE))
+                    gl_info->p_glBufferWriteUnsynchronizedWINE(dst_bo->binding, offset,
+                            ranges[i].size, src->addr + ranges[i].offset);
+                else
+                    GL_EXTCALL(glBufferSubData(dst_bo->binding, offset, ranges[i].size, src->addr + ranges[i].offset));
+            }
+            checkGLcall("unsynchronized buffer upload");
+
+            wined3d_context_gl_reference_bo(context_gl, dst_bo);
+        }
         else
         {
             wined3d_context_gl_bind_bo(context_gl, dst_bo->binding, dst_bo->id);
