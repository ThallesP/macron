 #include <unistd.h>
 #ifdef HAVE_SYS_SYSCTL_H
 #include <sys/sysctl.h>
@@ -50,9 +51,13 @@
 
 static mach_port_t server_mach_port;
 
+/* The server's only children on macOS are the ones that write the registry. */
 void sigchld_callback(void)
 {
-    assert(0);  /* should never be called on MacOS */
+    int status;
+    pid_t pid;
+
+    while ((pid = waitpid( -1, &status, WNOHANG )) > 0) registry_child_exited( pid, status );
 }
 
