+#ifdef __APPLE__
+
+/* The periodic save writes every modified branch whole, and the server has
+ * one thread: while it writes, every thread of every process that asks it
+ * anything waits. A prefix's system.reg is several megabytes; on a MacBook
+ * Air M3 the save took 63 to 152 ms, thirty seconds after a game's start,
+ * and Wine's audio timer, which sets its event through the server, was
+ * that late: 4 to 74 ms of sound missing, with any driver.
+ *
+ * So a child process writes the files, from the copy of the registry that
+ * fork() gives it, and the server goes on. The branches are marked clean
+ * when the child starts; if it fails they are marked modified again when it
+ * is reaped, and the next save or the one at exit writes them. Only one
+ * child at a time, and the save at exit waits for it, so that an older copy
+ * cannot land on top of a newer one. */
+
+static pid_t save_child;                           /* the child writing the registry, or 0 */
+static char save_child_branch[MAX_SAVE_BRANCH_INFO];  /* the branches it writes */
+
+static void save_child_done( int status )
+{
+    int i;
+
+    save_child = 0;
+    if (WIFEXITED( status ) && !WEXITSTATUS( status )) return;
+    for (i = 0; i < save_branch_count; i++)
+        if (save_child_branch[i]) save_branch_info[i].key->flags |= KEY_DIRTY;
+}
+
+/* called when a child of the server has exited */
+void registry_child_exited( pid_t pid, int status )
+{
+    if (pid == save_child) save_child_done( status );
+}
+
+static void wait_for_save_child(void)
+{
+    int status;
+
+    if (!save_child) return;
+    if (waitpid( save_child, &status, 0 ) == save_child) save_child_done( status );
+    else save_child = 0;
+}
+
+/* returns 0 if the save has to be done by the server itself */
+static int save_in_child(void)
+{
+    int i, dirty = 0, failed = 0;
+    pid_t pid;
+
+    if (save_child) return 1;  /* still writing: the next round takes what has changed since */
+    for (i = 0; i < save_branch_count; i++)
+    {
+        save_child_branch[i] = !!(save_branch_info[i].key->flags & KEY_DIRTY);
+        dirty |= save_child_branch[i];
+    }
+    if (!dirty) return 1;
+
+    if ((pid = fork()) == -1) return 0;
+    if (!pid)
+    {
+        if (fchdir( config_dir_fd ) == -1) _exit( 1 );
+        for (i = 0; i < save_branch_count; i++)
+            if (!save_branch( save_branch_info[i].key, save_branch_info[i].filename )) failed = 1;
+        _exit( failed );
+    }
+    save_child = pid;
+    for (i = 0; i < save_branch_count; i++) make_clean( save_branch_info[i].key );
+    return 1;
+}
+
+#else
+
+static void wait_for_save_child(void) { }
+static int save_in_child(void) { return 0; }
+
+#endif  /* __APPLE__ */
+
 /* periodic saving of the registry */
