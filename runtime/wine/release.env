# The Wine source the overlay is built from, Gcenx's build it replaces a file
# in, the PE compiler Gcenx's MacPorts overlay uses (configure needs one even
# though only a unix library is built), and the name of the release asset.
# Bump RELEASE_TAG for every new build: a published asset never changes, the
# runtime pins it by SHA-256.
WINE_VERSION=11.21
WINE_SOURCE_URL=https://github.com/wine-mirror/wine/archive/wine-11.21.tar.gz
WINE_SOURCE_SHA256=046cb0519b7d385be7912304910ccde9e3c0268ebdce7ef35a3c14446cfb8029
GCENX_WINE_URL=https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.21/wine-devel-11.21-osx64.tar.xz
GCENX_WINE_SHA256=9909b486657e10ab66c7279371ae1f990345b596b3b1b3a0cf21f28af24fa0ce
LLVM_MINGW_URL=https://github.com/mstorsjo/llvm-mingw/releases/download/20261020/llvm-mingw-20261020-ucrt-macos-universal.tar.xz
LLVM_MINGW_SHA256=e9c13e4ede38e715003ffc674d4d00a1088df8235439d1f0c16188ff0704c17e
RELEASE_TAG=runtime-wine-11.21-macron.1
ASSET_NAME=wine-11.21-macron.1-winemac-osx64.tar.xz
