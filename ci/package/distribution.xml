<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Macron</title>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="io.github.thallesp.macron"/>
    </choices-outline>
    <choice id="io.github.thallesp.macron" visible="false" title="Macron">
        <pkg-ref id="io.github.thallesp.macron"/>
    </choice>
    <pkg-ref id="io.github.thallesp.macron" version="@VERSION@" onConclusion="none">macron.pkg</pkg-ref>
</installer-gui-script>
